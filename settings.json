{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git show-ref:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git name-rev:*)",
      "Bash(git check-ignore:*)",
      "Bash(git count-objects:*)",
      "Bash(git version)",
      "Bash(git --version)",
      "Bash(git reflog)",
      "Bash(git reflog show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git tag)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
      "Bash(git remote get-url:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list)",
      "Bash(git config core.autocrlf)",
      "Bash(git worktree list:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git blame:*)",
      "PowerShell(git grep:*)",
      "PowerShell(git shortlog:*)",
      "PowerShell(git describe:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git rev-list:*)",
      "PowerShell(git merge-base:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git ls-remote:*)",
      "PowerShell(git ls-tree:*)",
      "PowerShell(git cat-file:*)",
      "PowerShell(git show-ref:*)",
      "PowerShell(git for-each-ref:*)",
      "PowerShell(git name-rev:*)",
      "PowerShell(git check-ignore:*)",
      "PowerShell(git count-objects:*)",
      "PowerShell(git version)",
      "PowerShell(git --version)",
      "PowerShell(git reflog)",
      "PowerShell(git reflog show:*)",
      "PowerShell(git branch)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -r)",
      "PowerShell(git branch -v)",
      "PowerShell(git branch -vv)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git tag)",
      "PowerShell(git remote)",
      "PowerShell(git remote -v)",
      "PowerShell(git remote show:*)",
      "PowerShell(git remote get-url:*)",
      "PowerShell(git config --get:*)",
      "PowerShell(git config --list)",
      "PowerShell(git config core.autocrlf)",
      "PowerShell(git worktree list:*)"
    ],
    "deny": [
      "Bash(git stage:*)",
      "Bash(git stash:*)",
      "Bash(git rm --cached:*)",
      "Bash(git restore --staged:*)",
      "Bash(git checkout --:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh release create:*)",
      "PowerShell(git stage:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git rm --cached:*)",
      "PowerShell(git restore --staged:*)",
      "PowerShell(git checkout --:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr edit:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh pr close:*)",
      "PowerShell(gh pr ready:*)",
      "PowerShell(gh issue create:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh release create:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~/source",
      "~/.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/git-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "opus",
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/statusline.ps1\""
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "eli5@claude-community": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      },
      "autoUpdate": false
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}